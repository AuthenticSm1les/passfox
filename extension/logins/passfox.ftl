# passfox overrides for Firefox's about:logins strings (loaded after them).
# Passwords live in pass, so that's the brand the page talks about, and
# features passfox doesn't have (breach alerts, import, Sync) aren't promised.

-brand-shorter-name = pass
-brand-short-name = pass
-brand-shortcut-name = pass
-brand-full-name = pass
-brand-product-name = pass

about-logins-page-title-name = Passwords

login-intro-description2 = Your passwords stay in your pass store, encrypted with your GPG key. passfox shows them here and decrypts one only when you reveal, copy or edit it.
about-logins-intro-import3 = Select the plus sign button above to add a password now.

about-logins-menu-menuitem-help = passfox Help
