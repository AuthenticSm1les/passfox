{
  "manifest_version": 3,
  "name": "passfox",
  "version": "0.2.0",
  "description": "Fill and save Firefox logins from pass, the standard unix password manager, using Firefox's own password manager look.",
  "browser_specific_settings": {
    "gecko": {
      "id": "passfox@smiley",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "shared/icons.js",
        "content/ui.js",
        "shared/doorhanger.js",
        "content/autofill.js",
        "content/save-prompt.js"
      ]
    }
  ],
  "action": {
    "default_title": "Passwords",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/login-dark.svg",
    "theme_icons": [
      {
        "light": "icons/login-light.svg",
        "dark": "icons/login-dark.svg",
        "size": 16
      },
      {
        "light": "icons/login-light.svg",
        "dark": "icons/login-dark.svg",
        "size": 32
      }
    ]
  },
  "icons": {
    "48": "icons/login-dark.svg",
    "96": "icons/login-dark.svg"
  },
  "homepage_url": "https://github.com/AuthenticSm1les/passfox"
}
